---
import { features } from '../data/features';
import { siteConfig } from '../data/site';
---

<section id="features" class="py-12 md:py-20 border-b border-[#232734] bg-[#090a0f] overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-2.5 sm:space-y-3 mb-8 sm:mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Tính Năng Toàn Diện
      </span>
      <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
        Tất Cả Công Cụ Bạn Cần Để Tối Đa Hóa Doanh Thu Zalo OA
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Từ tiếp nhận khách hàng thời gian thực đến chốt đơn, gọi điện và gửi ZNS tự động — được gói gọn trong một nền tảng.
      </p>
    </div>

    <!-- Tab Navigation (Scrollable on mobile, wrapped on desktop) -->
    <div class="mb-6 sm:mb-10 -mx-4 px-4 sm:mx-0 sm:px-0">
      <div class="flex items-center gap-1.5 sm:gap-2 p-1.5 bg-[#0d0f17] border border-[#232734] rounded-xl overflow-x-auto no-scrollbar touch-pan-x snap-x">
        {features.map((feature, idx) => (
          <button
            data-tab-btn={feature.id}
            class={`flex items-center gap-2 px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-150 whitespace-nowrap shrink-0 snap-start ${
              idx === 0
                ? 'bg-[#0068FF] text-white shadow-md'
                : 'text-slate-400 hover:text-white hover:bg-[#171a23]'
            }`}
          >
            <span>{feature.title.split('—')[0].trim()}</span>
            {feature.badge && (
              <span class="text-[10px] px-1.5 py-0.5 rounded font-mono font-medium bg-black/30 border border-white/10 text-slate-200">
                {feature.badge}
              </span>
            )}
          </button>
        ))}
      </div>
    </div>

    <!-- Feature Detail Panels -->
    {features.map((feature, idx) => {
      const resolvedImg = feature.image.startsWith('http')
        ? feature.image
        : `${import.meta.env.BASE_URL.replace(/\/$/, '')}${feature.image}`;

      return (
        <div
          data-tab-panel={feature.id}
          class={`grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center bg-[#0d0f17] border border-[#232734] rounded-xl sm:rounded-2xl p-4 sm:p-8 ${
            idx === 0 ? 'grid' : 'hidden'
          }`}
        >
          <!-- Left Column: Details -->
          <div class="lg:col-span-5 space-y-4 sm:space-y-5">
            <div class="space-y-2 sm:space-y-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-[#171a23] border border-[#282d3d] text-blue-400">
                  Phân hệ {feature.category.toUpperCase()}
                </span>
                {feature.badge && (
                  <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                    {feature.badge}
                  </span>
                )}
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug">
                {feature.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                {feature.fullDesc}
              </p>
            </div>

            <!-- Bullet Points -->
            <div class="space-y-2 sm:space-y-2.5 pt-1 sm:pt-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Điểm Nổi Bật:</span>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
                {feature.highlights.map((point) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- CTA Link -->
            <div class="pt-2 sm:pt-4">
              <a
                href={siteConfig.appUrl}
                class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-[#171a23] hover:bg-[#232734] border border-[#282d3d] rounded-lg transition-colors duration-150"
              >
                <span>Trải Nghiệm Tính Năng Này</span>
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right Column: Screenshot Frame with Click to Zoom -->
          <div class="lg:col-span-7 overflow-hidden">
            <div 
              class="group relative rounded-lg sm:rounded-xl overflow-hidden border border-[#232734] hover:border-[#0068FF]/50 bg-[#090a0f] shadow-lg cursor-zoom-in transition-colors"
              data-lightbox-trigger
              data-src={resolvedImg}
              data-title={feature.title}
            >
              <!-- Window Header -->
              <div class="px-3 py-1.5 sm:px-3.5 sm:py-2 bg-[#11131a] border-b border-[#232734] flex items-center justify-between text-[11px] sm:text-xs font-mono text-slate-400">
                <span class="truncate max-w-[200px] sm:max-w-none text-slate-300">{feature.image.replace('/screenshots/', '')}</span>
                <div class="flex items-center gap-1.5 text-slate-400 group-hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
                  </svg>
                  <span class="text-[11px] font-sans">Click để phóng lớn</span>
                </div>
              </div>

              <!-- Image Viewport -->
              <div class="relative p-2 sm:p-3 bg-[#090a0f] flex items-center justify-center min-h-[220px] sm:min-h-[380px]">
                <img
                  src={resolvedImg}
                  alt={feature.title}
                  class="w-full max-h-[360px] sm:max-h-[460px] object-contain rounded border border-[#1f2330] transition-transform duration-200 group-hover:scale-[1.01]"
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="540"
                />
              </div>
            </div>
          </div>
        </div>
      );
    })}

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll('[data-tab-btn]');
  const tabPanels = document.querySelectorAll('[data-tab-panel]');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-btn');
      
      tabButtons.forEach((b) => {
        const isCurrent = b.getAttribute('data-tab-btn') === targetId;
        b.className = `flex items-center gap-2 px-3 sm:px-4 py-2.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-150 whitespace-nowrap shrink-0 snap-start ${
          isCurrent
            ? 'bg-[#0068FF] text-white shadow-md'
            : 'text-slate-400 hover:text-white hover:bg-[#171a23]'
        }`;
      });

      tabPanels.forEach((panel) => {
        const isTarget = panel.getAttribute('data-tab-panel') === targetId;
        if (isTarget) {
          panel.classList.remove('hidden');
          panel.classList.add('grid');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('grid');
        }
      });
    });
  });
</script>
