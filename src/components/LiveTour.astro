---
import { siteConfig } from '../data/site';

const tourScreens = [
  {
    title: 'Hỗ Trợ Hội Thoại Đa OA',
    desc: 'Hộp thư tin nhắn thời gian thực qua WebSockets, điều phối phòng chat.',
    image: '/screenshots/02_chat_support.png',
    badge: 'Live Chat'
  },
  {
    title: 'Gọi Điện Zalo VoIP 1-Click',
    desc: 'Khởi tạo cuộc gọi thoại & video trực tiếp từ máy tính tới app Zalo của khách.',
    image: '/screenshots/14_calls.png',
    badge: 'Zalo Call'
  },
  {
    title: 'Quản Lý Đơn Hàng & Doanh Thu',
    desc: 'Lên đơn hàng, gắn mã phòng chat và lọc theo trạng thái thanh toán.',
    image: '/screenshots/04_order_management.png',
    badge: 'Đơn Hàng'
  },
  {
    title: 'Tự Động Hóa Mẫu Tin ZNS',
    desc: 'Tạo mẫu và gửi thông báo đơn hàng/chăm sóc khách qua SĐT & UID.',
    image: '/screenshots/03_zns_campaign.png',
    badge: 'ZNS'
  },
  {
    title: 'Ghi Chú CRM & Lưu Vết Khách',
    desc: 'Lưu giữ hồ sơ và thông tin trao đổi riêng biệt cho từng phòng hội thoại.',
    image: '/screenshots/05_customer_notes.png',
    badge: 'Ghi Chú'
  },
  {
    title: 'Phân Quyền & Giới Hạn Tin Nhắn',
    desc: 'Kiểm soát hạn mức tin nhắn hàng ngày cho từng nhân sự CSKH.',
    image: '/screenshots/08_staff_management.png',
    badge: 'Nhân Viên'
  }
];
---

<section id="demo" class="py-16 md:py-20 border-b border-[#232734] bg-[#090a0f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Trực Quan Giao Diện
      </span>
      <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
        Giao Diện Hiện Đại & Tối Ưu Thao Tác
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Các phân hệ chức năng thực tế được thiết kế trực quan, giúp đội ngũ làm quen ngay lập tức.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tourScreens.map((screen) => (
        <div class="rounded-xl overflow-hidden border border-[#232734] bg-[#0d0f17] flex flex-col">
          
          <!-- Image Frame -->
          <div class="relative bg-[#090a0f] border-b border-[#232734] p-2">
            <div class="absolute top-3.5 right-3.5 z-10">
              <span class="px-2 py-0.5 text-[10px] font-semibold text-slate-200 bg-[#171a23]/90 border border-[#282d3d] rounded">
                {screen.badge}
              </span>
            </div>
            <img
              src={screen.image.startsWith('http') ? screen.image : `${import.meta.env.BASE_URL.replace(/\/$/, '')}${screen.image}`}
              alt={screen.title}
              class="w-full h-48 object-cover object-top rounded border border-[#1f2330]"
              loading="lazy"
            />
          </div>

          <!-- Description -->
          <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <h3 class="text-base font-bold text-white">
                {screen.title}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed mt-1">
                {screen.desc}
              </p>
            </div>
            <div class="pt-1">
              <a
                href={siteConfig.appUrl}
                class="inline-flex items-center gap-1 text-xs font-semibold text-[#0068FF] hover:text-blue-400"
              >
                <span>Xem trên hệ thống</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
