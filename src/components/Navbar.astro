---
import { siteConfig } from '../data/site';
import type { NavItem } from '../types/landing';

const navItems: NavItem[] = [
  { label: 'Tính Năng', href: '#features' },
  { label: 'Vấn Đề & Giải Pháp', href: '#solutions' },
  { label: 'Giao Diện', href: '#demo' },
  { label: 'Bảng Giá', href: '#pricing' },
  { label: 'Bảo Mật', href: '#security' },
  { label: 'Hỏi Đáp', href: '#faq' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[#232734] bg-[#090a0f]/90 backdrop-blur-md transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo & Brand -->
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
      <img
        src={siteConfig.logo}
        alt="ZTKS Logo"
        class="w-9 h-9 rounded-lg object-cover border border-[#2e3446] group-hover:border-[#0068FF] transition-colors"
        width="36"
        height="36"
      />
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-bold text-lg tracking-tight text-white">{siteConfig.name}</span>
          <span class="px-1.5 py-0.5 text-[10px] font-semibold text-slate-300 bg-[#171a23] border border-[#282d3d] rounded">Zalo CRM</span>
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3.5 py-1.5 text-sm font-medium text-slate-300 hover:text-white transition-colors duration-150 rounded-md hover:bg-[#171a23]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={siteConfig.appUrl}
        class="px-3.5 py-1.5 text-sm font-medium text-slate-300 hover:text-white transition-colors duration-150 rounded-md hover:bg-[#171a23] border border-transparent hover:border-[#282d3d]"
      >
        Đăng Nhập
      </a>
      <a
        href={siteConfig.appUrl}
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-[#0068FF] hover:bg-[#0057d8] rounded-lg transition-colors duration-150 shadow-sm"
      >
        Trải Nghiệm Ngay
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-[#171a23] focus:outline-none border border-[#232734]"
      aria-label="Mở menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[#232734] bg-[#0d0f17] px-4 pt-3 pb-5 space-y-3">
    <div class="flex flex-col space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link px-3 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-[#171a23] rounded-md"
        >
          {item.label}
        </a>
      ))}
    </div>
    <div class="pt-3 border-t border-[#232734] flex flex-col gap-2">
      <a
        href={siteConfig.appUrl}
        class="w-full py-2 text-center text-sm font-medium text-slate-300 hover:text-white bg-[#171a23] border border-[#282d3d] rounded-lg"
      >
        Đăng Nhập
      </a>
      <a
        href={siteConfig.appUrl}
        class="w-full py-2 text-center text-sm font-semibold text-white bg-[#0068FF] hover:bg-[#0057d8] rounded-lg"
      >
        Dùng Thử Miễn Phí
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
