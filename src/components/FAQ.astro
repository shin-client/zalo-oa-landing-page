---
import { faqItems } from '../data/faq';
---

<section id="faq" class="py-16 md:py-20 border-b border-[#232734] bg-[#090a0f]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center space-y-3 mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Giải Đáp Thắc Mắc
      </span>
      <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight">
        Câu Hỏi Thường Gặp
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Những thông tin quan trọng trước khi bắt đầu triển khai ZTKS cho doanh nghiệp.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3">
      {faqItems.map((item) => (
        <details class="group rounded-xl bg-[#11131a] border border-[#232734] overflow-hidden transition-colors duration-150 open:border-[#2e3446]">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none font-semibold text-white text-sm sm:text-base hover:text-[#0068FF] transition-colors">
            <span>{item.question}</span>
            <span class="w-5 h-5 rounded-md bg-[#171a23] flex items-center justify-center text-slate-400 group-open:rotate-180 group-open:text-white transition-transform duration-150 shrink-0 ml-4">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-slate-300 leading-relaxed border-t border-[#1d212d]">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
