---
// Pure Vanilla Astro Lightbox Component (0 React runtime, 0 bundle bloat)
---

<div
  id="image-lightbox-modal"
  class="fixed inset-0 z-[9999] hidden flex-col items-center justify-between bg-black/95 backdrop-blur-md select-none touch-none opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-label="Xem ảnh phóng to"
>
  <!-- Top Header Bar -->
  <div class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-[#0d0f17]/95 border-b border-[#232734] flex items-center justify-between z-10">
    <div class="flex items-center gap-2 sm:gap-3 min-w-0 pr-2">
      <div class="p-1.5 rounded-md bg-[#171a23] border border-[#282d3d] text-slate-400 shrink-0">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"></path>
        </svg>
      </div>
      <div class="min-w-0">
        <h4 id="lightbox-title" class="text-xs sm:text-sm font-semibold text-white tracking-tight truncate">Xem ảnh thực tế</h4>
        <p class="text-[10px] sm:text-[11px] text-slate-400 font-mono hidden sm:block">Cuộn chuột hoặc chạm 2 lần để zoom</p>
      </div>
    </div>

    <!-- Toolbar Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <div class="flex items-center bg-[#171a23] border border-[#282d3d] rounded-lg p-0.5 text-xs text-slate-300">
        <button
          id="lightbox-zoom-out"
          class="p-2 sm:p-1.5 hover:text-white hover:bg-[#232734] active:bg-[#2e3446] rounded transition-colors disabled:opacity-40"
          title="Thu nhỏ (-)"
          aria-label="Thu nhỏ"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
          </svg>
        </button>
        <span id="lightbox-scale-display" class="px-1.5 sm:px-2.5 font-mono font-medium text-[11px] min-w-[42px] sm:min-w-[48px] text-center text-slate-300">
          100%
        </span>
        <button
          id="lightbox-zoom-in"
          class="p-2 sm:p-1.5 hover:text-white hover:bg-[#232734] active:bg-[#2e3446] rounded transition-colors disabled:opacity-40"
          title="Phóng to (+)"
          aria-label="Phóng to"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
          </svg>
        </button>
        <button
          id="lightbox-reset"
          class="p-2 sm:p-1.5 hover:text-white hover:bg-[#232734] active:bg-[#2e3446] rounded transition-colors border-l border-[#282d3d]"
          title="Đặt lại kích thước (0)"
          aria-label="Đặt lại kích thước"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </button>
      </div>

      <button
        id="lightbox-close"
        class="p-2 text-slate-300 hover:text-white bg-[#171a23] hover:bg-red-500/20 active:bg-red-500/30 hover:border-red-500/40 border border-[#282d3d] rounded-lg transition-all"
        title="Đóng (Esc)"
        aria-label="Đóng xem ảnh"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Main Image Stage -->
  <div
    id="lightbox-stage"
    class="flex-1 w-full flex items-center justify-center p-2 sm:p-6 overflow-hidden cursor-zoom-out"
  >
    <div id="lightbox-img-wrapper" class="transition-transform duration-75 ease-out relative">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[75vh] max-w-[94vw] sm:max-w-[90vw] object-contain rounded-lg border border-[#232734] shadow-2xl pointer-events-auto cursor-default"
        draggable="false"
      />
    </div>
  </div>

  <!-- Bottom Hint Bar -->
  <div class="w-full px-3 sm:px-4 py-2 sm:py-2.5 bg-[#090a0f]/90 border-t border-[#232734] flex items-center justify-between text-[10px] sm:text-[11px] text-slate-400">
    <div class="flex items-center gap-1.5 sm:gap-2">
      <span id="lightbox-hint" class="truncate">
        Chạm 2 lần để phóng to • Kéo 2 ngón tay để zoom
      </span>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button
        id="lightbox-bottom-close"
        class="px-3 py-1.5 bg-[#171a23] hover:bg-[#232734] active:bg-[#2e3446] border border-[#282d3d] text-white rounded-md text-xs font-medium transition-colors"
      >
        Đóng
      </button>
    </div>
  </div>
</div>

<script>
  let scale = 1;
  let posX = 0;
  let posY = 0;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let lastTap = 0;
  let touchDist = null;
  let initialTouchScale = 1;

  const modal = document.getElementById('image-lightbox-modal');
  const titleEl = document.getElementById('lightbox-title');
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const wrapper = document.getElementById('lightbox-img-wrapper');
  const scaleDisplay = document.getElementById('lightbox-scale-display');
  const hintEl = document.getElementById('lightbox-hint');
  const stage = document.getElementById('lightbox-stage');

  const btnZoomIn = document.getElementById('lightbox-zoom-in');
  const btnZoomOut = document.getElementById('lightbox-zoom-out');
  const btnReset = document.getElementById('lightbox-reset');
  const btnClose = document.getElementById('lightbox-close');
  const btnBottomClose = document.getElementById('lightbox-bottom-close');

  function updateTransform() {
    if (!wrapper || !scaleDisplay || !hintEl) return;
    wrapper.style.transform = `translate(${posX}px, ${posY}px) scale(${scale})`;
    scaleDisplay.textContent = `${Math.round(scale * 100)}%`;
    if (scale > 1) {
      hintEl.textContent = 'Kéo ngón tay / chuột để di chuyển ảnh';
      if (stage) stage.className = `flex-1 w-full flex items-center justify-center p-2 sm:p-6 overflow-hidden ${isDragging ? 'cursor-grabbing' : 'cursor-grab'}`;
    } else {
      hintEl.textContent = 'Chạm 2 lần để phóng to • Kéo 2 ngón tay để zoom';
      if (stage) stage.className = 'flex-1 w-full flex items-center justify-center p-2 sm:p-6 overflow-hidden cursor-zoom-out';
    }
  }

  function openModal(src: string, title?: string, alt?: string) {
    if (!modal || !img || !titleEl) return;
    img.src = src;
    img.alt = alt || title || 'Giao diện ZTKS';
    titleEl.textContent = title || 'Xem ảnh thực tế';
    scale = 1;
    posX = 0;
    posY = 0;
    updateTransform();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      scale = 1;
      posX = 0;
      posY = 0;
      updateTransform();
      document.body.style.overflow = '';
    }, 150);
  }

  window.addEventListener('open-lightbox', ((e: CustomEvent) => {
    if (e.detail?.src) {
      openModal(e.detail.src, e.detail.title, e.detail.alt);
    }
  }) as EventListener);

  btnClose?.addEventListener('click', closeModal);
  btnBottomClose?.addEventListener('click', closeModal);

  stage?.addEventListener('click', (e) => {
    if (e.target !== img && !isDragging) {
      closeModal();
    }
  });

  img?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  btnZoomIn?.addEventListener('click', () => {
    scale = Math.min(scale + 0.25, 3.5);
    updateTransform();
  });

  btnZoomOut?.addEventListener('click', () => {
    scale = Math.max(scale - 0.25, 0.5);
    updateTransform();
  });

  btnReset?.addEventListener('click', () => {
    scale = 1;
    posX = 0;
    posY = 0;
    updateTransform();
  });

  window.addEventListener('keydown', (e) => {
    if (modal && !modal.classList.contains('hidden')) {
      if (e.key === 'Escape') closeModal();
      else if (e.key === '+' || e.key === '=') {
        scale = Math.min(scale + 0.25, 3.5);
        updateTransform();
      } else if (e.key === '-' || e.key === '_') {
        scale = Math.max(scale - 0.25, 0.5);
        updateTransform();
      } else if (e.key === '0') {
        scale = 1;
        posX = 0;
        posY = 0;
        updateTransform();
      }
    }
  });

  // Wheel zoom
  modal?.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (e.deltaY < 0) {
      scale = Math.min(scale + 0.15, 3.5);
    } else {
      scale = Math.max(scale - 0.15, 0.5);
    }
    updateTransform();
  }, { passive: false });

  // Mouse drag
  modal?.addEventListener('mousedown', (e) => {
    if (scale > 1 && e.target === img) {
      isDragging = true;
      dragStartX = e.clientX - posX;
      dragStartY = e.clientY - posY;
    }
  });

  window.addEventListener('mousemove', (e) => {
    if (isDragging && scale > 1) {
      posX = e.clientX - dragStartX;
      posY = e.clientY - dragStartY;
      updateTransform();
    }
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
    updateTransform();
  });

  // Touch handlers
  modal?.addEventListener('touchstart', (e: TouchEvent) => {
    if (e.touches.length === 1) {
      const now = Date.now();
      if (now - lastTap < 300) {
        if (scale > 1) {
          scale = 1;
          posX = 0;
          posY = 0;
        } else {
          scale = 2;
        }
        updateTransform();
      }
      lastTap = now;

      if (scale > 1) {
        isDragging = true;
        dragStartX = e.touches[0].clientX - posX;
        dragStartY = e.touches[0].clientY - posY;
      }
    } else if (e.touches.length === 2) {
      const t1 = e.touches[0];
      const t2 = e.touches[1];
      touchDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
      initialTouchScale = scale;
    }
  }, { passive: true });

  modal?.addEventListener('touchmove', (e: TouchEvent) => {
    if (e.touches.length === 1 && isDragging && scale > 1) {
      posX = e.touches[0].clientX - dragStartX;
      posY = e.touches[0].clientY - dragStartY;
      updateTransform();
    } else if (e.touches.length === 2 && touchDist !== null) {
      const t1 = e.touches[0];
      const t2 = e.touches[1];
      const currentDist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
      const ratio = currentDist / touchDist;
      scale = Math.min(Math.max(initialTouchScale * ratio, 0.75), 3.5);
      updateTransform();
    }
  }, { passive: true });

  modal?.addEventListener('touchend', () => {
    isDragging = false;
    touchDist = null;
    updateTransform();
  }, { passive: true });
</script>
